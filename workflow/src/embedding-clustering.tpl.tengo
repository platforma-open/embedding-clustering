// Embedding-distance clustering. main.tpl.tengo renders this to do the actual work; cluster-results.tpl turns its
// output into the block's tables.
self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")


// exec.formula builders — size the clustering exec's RAM from its input file.
f := exec.formula

embeddingClusteringSw := assets.importSoftware("@platforma-open/milaboratories.embedding-clustering.software:embedding-clustering")

self.validateInputs({
	"__options__,closed": "",
	emptyOrNot: "any",
	embeddingMatrix: "any",
	keyCol: "string",
	dimCol: "string",
	valueCol: "string",
	"dims,?": "string",
	"minClusterSize,?": "number",
	"rescueNoise,?": "boolean",
	"maxClusterSize,?": "number",
	"mem,?": "number",
	"cpu,?": "number"
})

// clustersFile/dedupMapping/centroidDistances are the clustering's files (cluster-results.tpl reads them);
// clusteringLog is its stdout, surfaced by the UI as "Clustering Log".
self.defineOutputs("clustersFile", "dedupMapping", "centroidDistances", "clusteringLog", "isEmpty")

self.body(func(inputs) {
	minClusterSize := is_undefined(inputs.minClusterSize) ? 2 : inputs.minClusterSize
	// min_samples is the HDBSCAN density/noise knob (not user-exposed). Base value 5, but capped to
	// min_cluster_size, never larger.
	minSamples := 5
	if minClusterSize < minSamples {
		minSamples = minClusterSize
	}
	// Optional noise re-clustering: re-cluster the HDBSCAN noise pile to rescue dense sub-groups.
	rescueNoise := is_undefined(inputs.rescueNoise) ? true : inputs.rescueNoise

	baseMemGiB := 32
	if !is_undefined(inputs.mem) {
		baseMemGiB = inputs.mem
	}

	if string(inputs.emptyOrNot.getData()) == "empty" {
		// Nothing to cluster: cluster-results.tpl writes the empty tables.
		return {
			clustersFile: {},
			dedupMapping: {},
			centroidDistances: {},
			clusteringLog: {},
			isEmpty: true
		}
	} else {
		// 8 cores by default: the clustering's parallel phases stop speeding up beyond 8, and the model blocks a
		// larger setting.
		cpu := 8
		if !is_undefined(inputs.cpu) {
			cpu = inputs.cpu
		}

		// Step 1: embedding-distance clustering. Streamed load + IncrementalPCA-95 (cap 500) ->
		// L2-normalize -> collapse identical vectors -> HDBSCAN(eom) on the representatives -> split of huge
		// outlier clusters (+ optional size-capped noise rescue) -> medoid representative; leftover noise ->
		// singleton clusters. Emits a headerless clusters.tsv (rep -> cluster), a headered dedup_mapping.tsv
		// (clonotype -> representative) and a headered
		// centroid_distances.tsv (per-representative cosine distance to the medoid).
		embClustBuilder := exec.builder().
			name("embedding-clustering").
			software(embeddingClusteringSw).
			printErrStreamToStdout().
			addFile("embedding.parquet", inputs.embeddingMatrix, { tag: "input" }).
			arg("--matrix").arg("embedding.parquet").
			arg("--key-col").arg(inputs.keyCol).
			arg("--dim-col").arg(inputs.dimCol).
			arg("--value-col").arg(inputs.valueCol).
			arg("--min-cluster-size").arg(string(minClusterSize)).
			arg("--min-samples").arg(string(minSamples)).
			arg("--threads").argExpr("{system.cpu}")

		// Resources: an explicit `mem` (Advanced Settings) is honored verbatim; otherwise RAM scales
		// with the input parquet size (f.size). Streaming + IncrementalPCA decouples RAM from input
		// size (the full N x D matrix is never held), so peak RSS is bounded by the reduced N x k
		// array + HDBSCAN + the refinement re-PCA budget (RAM_BUDGET_GIB=16 in the software;
		// larger refined sets spill to a disk memmap instead of RAM).
		if !is_undefined(inputs.mem) {
			embClustBuilder = embClustBuilder.resources({
				onCPU: { cpu: cpu, ram: string(baseMemGiB) + "GiB" }
			})
		} else {
			size := f.size("input")
			embClustBuilder = embClustBuilder.resources({
				onCPU: {
					cpu: cpu,
					ram: size.times(8).plus(f.gib(24)).between(f.gib(32), f.gib(256)).staticFallback(f.gib(64))
				}
			})
		}

		// Pass the embedding vector length D when the input column's spec annotation carries it, so the
		// loader can size/validate the matrix without inferring D from the data.
		if !is_undefined(inputs.dims) {
			embClustBuilder = embClustBuilder.arg("--dims").arg(inputs.dims)
		}

		if rescueNoise {
			embClustBuilder = embClustBuilder.arg("--rescue-noise")
		}
		// Optional maximum cluster size (distinct embeddings): caps the clustering and the noise rescue instead of
		// splitting oversized clusters.
		if !is_undefined(inputs.maxClusterSize) {
			embClustBuilder = embClustBuilder.arg("--max-cluster-size").arg(string(inputs.maxClusterSize))
		}

		embClust := embClustBuilder.
			saveFile("clusters.tsv").
			saveFile("dedup_mapping.tsv").
			saveFile("centroid_distances.tsv").
			saveStdoutStream().
			run()

		return {
			clustersFile: embClust.getFile("clusters.tsv"),
			dedupMapping: embClust.getFile("dedup_mapping.tsv"),
			centroidDistances: embClust.getFile("centroid_distances.tsv"),
			clusteringLog: embClust.getStdoutStream(),
			isEmpty: false
		}
	}
})
